# Firebase Configuration
# Copy this file to .env and fill in the actual values
# Never commit .env to version control

# Environment (staging or production)
ENVIRONMENT=staging

# Firebase Project IDs
FIREBASE_PROJECT_ID_STAGING=your-staging-project-id
FIREBASE_PROJECT_ID_PRODUCTION=your-production-project-id

# Firebase API Keys (optional, usually auto-configured by flutterfire)
FIREBASE_API_KEY=your-api-key
FIREBASE_AUTH_DOMAIN=your-auth-domain
FIREBASE_DATABASE_URL=your-database-url
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-storage-bucket
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-app-id

# Feature Flags
# Set to true in staging when integrating new features
# Set to false in production until feature is fully ready
ENABLE_REALTIME_STUDY_ROOM=false
ENABLE_CLOUD_FUNCTIONS=false
ENABLE_CLOUD_SQL=false

# Cloud Functions runtime configuration (used by functions/cloudsql.js)
# Set via: firebase functions:config:set cloudsql.enabled="true" \
#          cloudsql.connection_name="PROJECT:REGION:INSTANCE" \
#          cloudsql.db_user="..." cloudsql.db_password="..." cloudsql.db_name="studyquest"
# CLOUDSQL_ENABLED=false
# CLOUDSQL_CONNECTION_NAME=your-project:region:instance
# CLOUDSQL_DB_USER=postgres
# CLOUDSQL_DB_PASSWORD=your-db-password
# CLOUDSQL_DB_NAME=studyquest
