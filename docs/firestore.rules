rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection
    match /users/{userId} {
      // Allow read if user is the owner
      allow read: if request.auth != null && request.auth.uid == userId;

      // Allow create if user is the owner
      allow create: if request.auth != null && request.auth.uid == userId;

      // Allow update for all fields (development mode)
      // Note: In production, xp, level, and streak should be updated by Cloud Functions
      allow update: if request.auth != null && request.auth.uid == userId;
    }

    // Quests collection
    match /quests/{questId} {
      // Allow read if user owns the quest
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Allow create if user is authenticated and setting their own userId
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.isCompleted == false;
      
      // Allow update if user owns the quest
      // Prevent changing userId or isCompleted without proper validation
      allow update: if request.auth != null 
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId;
      
      // Allow delete if user owns the quest
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Activities collection
    match /activities/{activityId} {
      // Allow read if user owns the activity
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Allow create if user is authenticated and setting their own userId
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Prevent updates (activities should be immutable)
      allow update: if false;
      
      // Allow delete if user owns the activity
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Achievements collection (read-only for all authenticated users)
    match /achievements/{achievementId} {
      allow read: if request.auth != null;
      allow write: if false; // Only server can write
    }

    // User achievements collection
    match /user_achievements/{userAchievementId} {
      // Allow read/write if user owns the achievement
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Allow create if user is authenticated and setting their own userId
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
